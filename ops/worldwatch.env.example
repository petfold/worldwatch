# Worldwatch runtime environment — copy to /etc/worldwatch/worldwatch.env
# and edit. Referenced by every systemd unit via EnvironmentFile=.
# Never commit real secrets; this file lives on the host, not in the repo.

# --- storage ---
WW_DB_PATH=/var/lib/worldwatch/worldwatch.db
# WW_CONFIG_DIR defaults to the packaged stanzas; override to add your own:
# WW_CONFIG_DIR=/etc/worldwatch/sources

# raw_ring retention before consolidation. Smaller = surprise scored sooner;
# larger = more fine-resolution history retained.
WW_FINE_WINDOW_SECONDS=900

# evidence store (what each observation was: place, headline, link) — fixed
# size, oldest evicted first
WW_CONTEXT_BUDGET_MB=2048

# --- dashboard/API ---
WW_API_HOST=127.0.0.1
WW_API_PORT=8000

# --- push notifications (choose ntfy; leave unset for a silent no-op) ---
# WW_NTFY_SERVER=https://ntfy.sh
# WW_NTFY_TOPIC=worldwatch-alerts-CHANGEME
# WW_NTFY_TOKEN=
# Public dashboard (ops/nginx/worldwatch-public.conf); pushes deep-link into it:
# WW_DASHBOARD_URL=https://categor.io:8001

# --- per-source API keys (operator registers; see doc/OPERATOR-TODO.md) ---
# WW_CLOUDFLARE_TOKEN=

# Push budget: about WW_PUSH_PER_DAY pushes a day, the most serious (never twice that
# in 24 h), none scoring below WW_PUSH_MIN_SCORE (see alerts.engine.alert_score); the
# rest stay on the dashboard. Extreme alerts (confirmed by two kinds of measurement,
# scoring WW_PUSH_EXTREME_SCORE or more) are pushed at priority 5, at most
# WW_PUSH_EXTREME_PER_WEEK a week. A very strong single signal is pushed at once as
# "Unconfirmed" (priority 3), and pushed again as it is confirmed ("Confirmed", 4) or
# turns extreme (5), skipping the budget: each alert at most once per stage.
# WW_PUSH_PER_DAY=2
# WW_PUSH_MIN_SCORE=8
# WW_PUSH_EXTREME_SCORE=15
# WW_PUSH_EXTREME_PER_WEEK=1
# Where the operator is: 'lat,lon', or several 'lat,lon; lat,lon' (city-level is enough).
# When set, only events that can reach one of these places (a stanza's [alerts]
# reach_km) may wake (priority 5) or go above 3; the rest say "far away". The push
# never states the distance, so it does not locate you. Unset: every event may.
# WW_HOME=
# Until this date/time (UTC; or epoch seconds) every push is silent (ntfy priority <= 2).
# WW_PUSH_SILENT_UNTIL=2026-10-04
